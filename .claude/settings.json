{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npx vitest run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git tag -l *)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(curl -s -o /dev/null -w * http://localhost:8080/)",
      "Bash(curl -sI http://localhost:8080/)"
    ]
  }
}
