# Copy to .env.local for development. Never commit a real .env file.
#
# Vite exposes every VITE_* variable to the browser bundle. Only put values here
# that are safe to publish. Secrets that must stay private (the Gemini API key)
# are entered by the user at runtime and live in the encrypted vault — never here.

# Google OAuth client ID for Drive (appDataFolder) access.
# Public by design: it ships inside the SPA and is not a credential on its own.
# Create it at https://console.cloud.google.com/apis/credentials and add the
# app origins (http://localhost:5173 and https://eatmyway.gorny.dev) to the
# authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
