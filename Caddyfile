# Caddy serves the prebuilt SPA as static files. It listens on plain HTTP :8080;
# in production nginx terminates TLS for eatmyway.gorny.dev and proxies here.
# Caddy is the single source of the security headers — nginx must not add its
# own, or browsers receive duplicates.

{
	admin off
	auto_https off
	servers {
		# nginx sits in front; without this Caddy would log the proxy's address.
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		# No 'unsafe-inline' and no 'unsafe-eval' anywhere. connect-src is limited
		# to this origin plus the three Google APIs the app talks to directly from
		# the browser (Gemini, Drive, Google Identity Services).
		#
		# Phase 6 widened this in exactly three places, and no further:
		#   script-src https://accounts.google.com  — the Google Identity Services
		#     client, loaded on demand when the user connects Drive.
		#   frame-src  https://accounts.google.com  — GIS's own frames.
		#   'wasm-unsafe-eval'                      — Chrome refuses to compile any
		#     WebAssembly under a CSP without it, and the vault's Argon2id (hash-wasm,
		#     in a Web Worker) is WebAssembly. It permits WebAssembly compilation
		#     only; it does not bring back eval() or inline script.
		# See STATE.md decisions 86 and 87.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://www.googleapis.com https://accounts.google.com; worker-src 'self' blob:; frame-src https://accounts.google.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), payment=(), usb=()"
		# Google Identity Services returns the access token through a popup, and
		# 'same-origin' severs the opener reference that carries it. This is the
		# narrowest value that keeps the popup working (STATE.md decision 86).
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		# Version and stack are nobody's business.
		-Server
	}

	# Hashed bundle assets are immutable; the entry document never is. Matched on
	# the requested path, before try_files rewrites a deep link to index.html.
	@immutable path /assets/*
	@document not path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header @document Cache-Control "no-cache"

	# Routing is hash-based, so this only catches typo'd paths and deep links
	# saved before the app existed. Everything resolves to the one document.
	try_files {path} /index.html
	file_server
}
